+      globalThis.fetch = async () => ({
+        ok: true,
+        json: async () => ({
+          success: true,
+          data: [{ type: "Concentrated", day: { volumeFee: 2062.19 }, week: { volumeFee: 9561.89 } }],
+        }),
+      });
+      const info = await client.fetchPoolFees("PAIRADDR");
+      assert.equal(info.dayUsd.toFixed(2), "2062.19");
+      assert.equal(info.weekUsd.toFixed(2), "9561.89");
+
+      // Non-Raydium pool: success:false / empty data → null (never judges).
+      globalThis.fetch = async () => ({
+        ok: true,
+        json: async () => ({ id: "x", success: false, msg: "query ids value error" }),
+      });
+      assert.equal(await client.fetchPoolFees("METEORAPOOL"), null);
+
+      // HTTP failure → best-effort null.
+      globalThis.fetch = async () => ({ ok: false, status: 503 });
+      assert.equal(await client.fetchPoolFees("ANY"), null);
+
+      // Empty address short-circuits without a fetch.
+      let called = false;
+      globalThis.fetch = async () => { called = true; return { ok: true, json: async () => ({}) }; };
+      assert.equal(await client.fetchPoolFees(""), null);
+      assert.equal(called, false);
+    } finally {
+      globalThis.fetch = originalFetch;
+    }
+  });
+
