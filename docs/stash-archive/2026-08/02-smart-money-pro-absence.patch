+/**
+ * Smart-money absence alert (the DOTE/BAOJIN shape): a pushed coin that has
+ * PUMPED ≥ gainAlertPct since push but still shows ZERO Birdeye smart_trader
+ * wallets among its top traders. Push-time gating is impossible — even CONK
+ * showed 0 pros at push (smart money arrives late) — so the signal is only
+ * evaluated once, after proCheckDelayMin, on coins that have actually run.
+ * Returns the alert text, or null when the coin is fine / data unknown.
+ */
+export function proAbsenceAlert(
+  proTraders: number | null,
+  gainPct: number,
+  gainAlertPct: number,
+): string | null {
+  if (proTraders === null) return null; // no trader data — cannot judge
+  if (proTraders > 0) return null; // smart money present — healthy
+  if (!(gainPct >= gainAlertPct)) return null; // hasn't run — absence is normal
+  return (
+    `🧠 聰明錢缺席：推送後已漲 +${gainPct.toFixed(0)}%，` +
+    `但 24h 內仍無任何 smart_trader 進場（DOTE/BAOJIN 型形態——漲幅無聰明錢背書）`
+  );
+}
