+  /**
+   * Audit block for ONE mint (the insider-gate fallback when RugCheck has
+   * no data). Cached in-memory — a candidate re-checked on later ticks
+   * costs no extra call.
+   */
+  async fetchAudit(mint: string): Promise<JupAudit | null> {
+    if (!MINT_RE.test(mint)) return null;
+    const cached = this.auditCache.get(mint);
+    if (cached !== undefined) return cached;
+    let audit: JupAudit | null = null;
+    try {
+      const data = (await this.get(`/search?query=${mint}`)) as Array<
+        Record<string, unknown>
+      > | null;
+      const entry = Array.isArray(data)
+        ? data.find((t) => t && (t as { id?: unknown }).id === mint)
+        : undefined;
+      if (entry) {
+        const a = entry.audit as Record<string, unknown> | undefined;
+        audit = {
+          topHoldersPercentage: auditNum(a?.topHoldersPercentage),
+          devBalancePercentage: auditNum(a?.devBalancePercentage),
+          devMints: auditNum(a?.devMints),
+        };
+      }
+    } catch {
+      audit = null;
+    }
+    if (this.auditCache.size > 2_000) this.auditCache.clear();
+    this.auditCache.set(mint, audit);
+    return audit;
+  }
 }
