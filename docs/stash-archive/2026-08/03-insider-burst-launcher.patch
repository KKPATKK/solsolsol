+/** Jupiter `audit` block — holder/dev concentration signals (no bundler%). */
+export interface JupAudit {
+  topHoldersPercentage: number | null;
+  devBalancePercentage: number | null;
+  devMints: number | null;
+}
+
+function auditNum(v: unknown): number | null {
+  if (v === undefined || v === null) return null;
+  const n = Number(v);
+  return Number.isFinite(n) ? n : null;
+}
+
+/**
+ * Pure fallback gate used ONLY when the RugCheck report has no data:
+ * blocks on top-holder concentration (Jupiter's topHoldersPercentage as
+ * the top10 substitute) and on serial-launcher devs whose mint count
+ * reaches the threshold (a dev with hundreds of launches is a factory).
+ * Null audit never blocks.
+ */
+export function jupAuditBlockReason(
+  audit: JupAudit | null,
+  maxTop10Pct: number,
+  maxDevMints: number,
+): string | null {
+  if (!audit) return null;
+  const parts: string[] = [];
+  if (
+    maxTop10Pct > 0 &&
+    audit.topHoldersPercentage !== null &&
+    audit.topHoldersPercentage >= maxTop10Pct
+  )
+    parts.push(
+      `Top持倉 ${audit.topHoldersPercentage.toFixed(1)}% ≥ ${maxTop10Pct}%`,
+    );
+  if (
+    maxDevMints > 0 &&
+    audit.devMints !== null &&
+    audit.devMints >= maxDevMints
+  )
+    parts.push(`連環發行商（歷史 ${audit.devMints} 個幣）`);
+  return parts.length > 0 ? parts.join("；") : null;
+}
