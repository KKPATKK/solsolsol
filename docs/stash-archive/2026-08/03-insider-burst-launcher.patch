+/**
+ * Pure insider-concentration gate (exported for offline unit tests).
+ * Returns a reject reason when the RugCheck report shows bundled-wallet
+ * buying or top-10 concentration above the configured thresholds, null
+ * when the coin passes or the report has no data yet (nulls never block —
+ * same stance as the card: 未檢測 ≠ 有罪).
+ */
+export function insiderBlockReason(
+  bundlerPct: number | null,
+  top10Pct: number | null,
+  maxBundlerPct: number,
+  maxTop10Pct: number,
+): string | null {
+  const parts: string[] = [];
+  if (
+    maxBundlerPct > 0 &&
+    bundlerPct !== null &&
+    bundlerPct >= maxBundlerPct
+  )
+    parts.push(`捆綁錢包買入 ${bundlerPct.toFixed(1)}% ≥ ${maxBundlerPct}%`);
+  if (maxTop10Pct > 0 && top10Pct !== null && top10Pct >= maxTop10Pct)
+    parts.push(`Top10 持倉 ${top10Pct.toFixed(1)}% ≥ ${maxTop10Pct}%`);
+  return parts.length > 0 ? parts.join("；") : null;
+}
+
+/**
+ * Pure burst-launcher gate (exported for offline unit tests).
+ *
+ * Catches the "token farm" launch pattern: the same dev wallet mints several
+ * tokens around the same time (e.g. DOTE: dev launched 2 other pump.fun
+ * tokens within 10 minutes of the pushed one). Organic devs essentially
+ * never do this; serial-launcher farms always do.
+ *
+ * @param otherTokenAgeHours ages (hours ago) of the creator's OTHER known
+ *   token launches, or null when unknown (never blocks on unknown).
+ * @param windowHours how far back a launch counts as "recent".
+ * @param maxOtherTokens maximum tolerated recent launches (block when the
+ *   count EXCEEDS this, i.e. >= maxOtherTokens + 1). 0 disables the gate.
+ */
+export function burstLaunchBlockReason(
+  otherTokenAgeHours: number[] | null,
+  windowHours: number,
+  maxOtherTokens: number,
+): string | null {
+  if (
+    maxOtherTokens <= 0 ||
+    windowHours <= 0 ||
+    !Array.isArray(otherTokenAgeHours)
+  )
+    return null;
+  const recent = otherTokenAgeHours.filter(
+    (h) => Number.isFinite(h) && h >= 0 && h <= windowHours,
+  ).length;
+  if (recent > maxOtherTokens) {
+    return `連環發射場：dev 於 ${windowHours}h 內另發射了 ${recent} 枚幣（> ${maxOtherTokens}）`;
+  }
+  return null;
+}
